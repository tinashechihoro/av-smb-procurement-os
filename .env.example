# ============================================================================
# AV Motors x SMB Procurement OS — Environment Configuration
# Copy this file to .env and fill in production values
# ============================================================================

# ── Database ────────────────────────────────────────────────────────────────
DB_NAME=avsmc_procurement
DB_USERNAME=avsmc_admin
DB_PASSWORD=CHANGE_ME_strong_password_here
DB_PORT=5432
DB_POOL_MAX=20
DB_POOL_MIN=5

# ── Backend ─────────────────────────────────────────────────────────────────
SERVER_PORT=4000
SPRING_PROFILES_ACTIVE=prod
BACKEND_PORT=4000

# ── Security ────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 64
JWT_SECRET=CHANGE_ME_generate_a_random_64_byte_secret_key_here
JWT_EXPIRATION_MS=3600000
JWT_REFRESH_EXPIRATION_MS=86400000
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION=15
PASSWORD_MIN_LENGTH=8

# ── CORS ────────────────────────────────────────────────────────────────────
CORS_ORIGINS=https://your-production-domain.com,https://app.your-domain.com

# ── SSL ─────────────────────────────────────────────────────────────────────
SSL_ENABLED=false
SSL_KEY_STORE=
SSL_KEY_STORE_PASSWORD=

# ── Storage ─────────────────────────────────────────────────────────────────
STORAGE_TYPE=local
STORAGE_LOCAL_PATH=./uploads
S3_BUCKET=
S3_REGION=

# ── Frontend ────────────────────────────────────────────────────────────────
FRONTEND_PORT=80

# ── Logging ─────────────────────────────────────────────────────────────────
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_APP=INFO
LOG_LEVEL_SQL=WARN
LOG_LEVEL_SECURITY=WARN

# ── Audit ───────────────────────────────────────────────────────────────────
AUDIT_RETENTION_DAYS=2555

# ── Email ───────────────────────────────────────────────────────────────────
EMAIL_FROM=noreply@your-domain.com
